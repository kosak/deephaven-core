<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Matches the client library, so a ProjectReference to it resolves on either SDK. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>1701;1702;1591;612</NoWarn>
    <RootNamespace>Deephaven.BarrageRepro</RootNamespace>
    <AssemblyName>BarrageRepro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\client\Dh_NetClient\Dh_NetClient.csproj" />
  </ItemGroup>

</Project>
